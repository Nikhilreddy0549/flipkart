pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    parameters {
        choice(
            name: 'CONFIG_TYPE',
            choices: ['environment', 'node'],
            description: 'Select which configuration to update'
        )

        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'stage', 'uat', 'prod'],
            description: 'Select the target environment'
        )

        string(
            name: 'CONFIG_KEY',
            defaultValue: 'appName',
            description: 'JSON key to update'
        )

        string(
            name: 'CONFIG_VALUE',
            defaultValue: 'flipkart',
            description: 'New value for the JSON key'
        )
    }

    environment {
        GITHUB_REPO = 'Nikhilreddy0549/flipkart'
        GITHUB_BRANCH = 'feature'
        TARGET_BRANCH = 'main'
        SONARQUBE_PROJECT_KEY = 'flipkart'
    }

    stages {

        stage('Checkout') {
            steps {
                git(
                    url: 'git@github.com:Nikhilreddy0549/flipkart.git',
                    branch: 'feature',
                    credentialsId: 'github-ssh'
                )
            }
        }

        stage('Update Configuration') {
            steps {
                script {
                    def configDirectory =
                        params.CONFIG_TYPE == 'environment'
                        ? 'environment'
                        : 'node'

                    env.CONFIG_FILE =
                        "${configDirectory}/${params.ENVIRONMENT}.json"

                    env.VALIDATOR =
                        params.CONFIG_TYPE == 'environment'
                        ? 'validation/validate_environment.py'
                        : 'validation/validate_node.py'

                    if (!fileExists(env.CONFIG_FILE)) {
                        error("Configuration file not found: ${env.CONFIG_FILE}")
                    }

                    if (!fileExists(env.VALIDATOR)) {
                        error("Validator not found: ${env.VALIDATOR}")
                    }

                    withEnv([
                        "CONFIG_FILE=${env.CONFIG_FILE}",
                        "CONFIG_KEY=${params.CONFIG_KEY}",
                        "CONFIG_VALUE=${params.CONFIG_VALUE}"
                    ]) {
                        sh '''
                            python3 - <<'PY'
import json
import os

file_path = os.environ["CONFIG_FILE"]
key = os.environ["CONFIG_KEY"]
raw_value = os.environ["CONFIG_VALUE"]

try:
    value = json.loads(raw_value)
except json.JSONDecodeError:
    value = raw_value

with open(file_path, "r", encoding="utf-8") as f:
    data = json.load(f)

data[key] = value

with open(file_path, "w", encoding="utf-8") as f:
    json.dump(data, f, indent=2)
    f.write("\\n")

print("Updated configuration file:", file_path)
print("Updated key:", key)
PY
                        '''
                    }
                }
            }
        }

        stage('Validate JSON') {
            steps {
                sh '''
                    python3 -m json.tool "$CONFIG_FILE" > /dev/null
                    echo "JSON syntax validation passed."
                '''
            }
        }

        stage('Run Configuration Validator') {
            steps {
                sh '''
                    python3 "$VALIDATOR" "$CONFIG_FILE" "$ENVIRONMENT"
                '''
            }
        }

        stage('Maven Build and Test') {
            steps {
                sh '''
                    mvn clean test
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'sonarqube-token',
                        variable: 'SONAR_TOKEN'
                    )
                ]) {
                    withSonarQubeEnv('SonarQube') {
                        sh '''
                            mvn sonar:sonar \
                              -Dsonar.projectKey=flipkart \
                              -Dsonar.host.url=http://172.31.8.21:9000 \
                              -Dsonar.token="$SONAR_TOKEN"
                        '''
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    script {
                        def qualityGate = waitForQualityGate()
                        if (qualityGate.status != 'OK') {
                            error("SonarQube Quality Gate failed: ${qualityGate.status}")
                        }
                        echo 'SonarQube Quality Gate passed.'
                    }
                }
            }
        }

        stage('Deploy to Nexus') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus-credentials',
                        usernameVariable: 'NEXUS_USERNAME',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )
                ]) {
                    configFileProvider([
                        configFile(
                            fileId: 'MySettings',
                            variable: 'MAVEN_SETTINGS'
                        )
                    ]) {
                        sh '''
                            mvn -s "$MAVEN_SETTINGS" deploy -DskipTests
                        '''
                    }
                }
            }
        }

        stage('Commit Changes') {
            steps {
                script {
                    sh '''
                        git config user.name "Jenkins"
                        git config user.email "jenkins@localhost"

                        git add "$CONFIG_FILE"

                        if git diff --cached --quiet; then
                            echo "No configuration changes to commit."
                        else
                            git commit -m "Update ${CONFIG_FILE}: ${CONFIG_KEY}"
                        fi
                    '''
                }
            }
        }

        stage('Push Feature Branch') {
            steps {
                sshagent(credentials: ['github-ssh']) {
                    sh '''
                        git push origin HEAD:feature
                    '''
                }
            }
        }

        stage('Create or Find Pull Request') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'github-token',
                        variable: 'GH_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu

                        export GH_REPO="$GITHUB_REPO"

                        PR_NUMBER=$(gh pr list \
                            --repo "$GITHUB_REPO" \
                            --base main \
                            --head feature \
                            --state open \
                            --json number \
                            --jq '.[0].number // empty')

                        if [ -z "$PR_NUMBER" ]; then
                            PR_URL=$(gh pr create \
                                --repo "$GITHUB_REPO" \
                                --base main \
                                --head feature \
                                --title "Update ${CONFIG_TYPE} configuration for ${ENVIRONMENT}" \
                                --body "Automated configuration update generated by Jenkins build ${BUILD_NUMBER}.")

                            echo "Created pull request: $PR_URL"
                        else
                            echo "Using existing open pull request #$PR_NUMBER"
                        fi
                    '''
                }
            }
        }

        stage('Validate Pull Request') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'github-token',
                        variable: 'GH_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu

                        PR_NUMBER=$(gh pr list \
                            --repo "$GITHUB_REPO" \
                            --base main \
                            --head feature \
                            --state open \
                            --json number \
                            --jq '.[0].number // empty')

                        if [ -z "$PR_NUMBER" ]; then
                            echo "No open pull request found."
                            exit 1
                        fi

                        gh pr view "$PR_NUMBER" \
                            --repo "$GITHUB_REPO" \
                            --json state,baseRefName,headRefName \
                            --jq '
                              if .state == "OPEN"
                                 and .baseRefName == "main"
                                 and .headRefName == "feature"
                              then
                                "Pull request validation passed."
                              else
                                error("Pull request validation failed.")
                              end
                            '
                    '''
                }
            }
        }

        stage('Merge Pull Request') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'github-token',
                        variable: 'GH_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu

                        PR_NUMBER=$(gh pr list \
                            --repo "$GITHUB_REPO" \
                            --base main \
                            --head feature \
                            --state open \
                            --json number \
                            --jq '.[0].number // empty')

                        if [ -z "$PR_NUMBER" ]; then
                            echo "No open pull request to merge."
                            exit 1
                        fi

                        gh pr merge "$PR_NUMBER" \
                            --repo "$GITHUB_REPO" \
                            --merge
                    '''
                }
            }
        }

        stage('Verify Merge') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'github-token',
                        variable: 'GH_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu

                        gh pr list \
                            --repo "$GITHUB_REPO" \
                            --base main \
                            --head feature \
                            --state merged \
                            --json number,mergedAt \
                            --jq '
                              if length > 0
                              then "Merged pull request verified."
                              else error("No merged pull request found for feature -> main.")
                              end
                            '
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully.'
        }

        failure {
            echo 'Pipeline failed. Check the stage logs above for the cause.'
        }

        always {
            echo "Build result: ${currentBuild.currentResult}"
        }
    }
}
