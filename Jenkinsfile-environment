pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    parameters {
        choice(
            name: 'CONFIG_TYPE',
            choices: ['environment', 'node'],
            description: 'Select configuration type'
        )
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'stage', 'uat', 'prod'],
            description: 'Select environment'
        )
        string(
            name: 'CONFIG_KEY',
            defaultValue: 'appName',
            description: 'JSON key to modify'
        )
        string(
            name: 'CONFIG_VALUE',
            defaultValue: 'flipkart',
            description: 'New value for the selected JSON key'
        )
    }

    environment {
        REPO_URL = 'git@github.com:Nikhilreddy0549/flipkart.git'
        REPO_NAME = 'Nikhilreddy0549/flipkart'
        BRANCH_NAME = 'feature'
        SONAR_PROJECT_KEY = 'flipkart-config-automation'
    }

    stages {
        stage('Checkout feature') {
            steps {
                deleteDir()

                sshagent(credentials: ['github-ssh']) {
                    sh '''
                        set -eu
                        git clone --branch "$BRANCH_NAME" \
                            "$REPO_URL" .
                        git checkout "$BRANCH_NAME"
                    '''
                }
            }
        }

        stage('Modify selected JSON') {
            steps {
                script {
                    def configDir = params.CONFIG_TYPE
                    def configFile =
                        "${configDir}/${params.ENVIRONMENT}.json"

                    withEnv([
                        "CONFIG_FILE=${configFile}",
                        "CONFIG_KEY=${params.CONFIG_KEY}",
                        "CONFIG_VALUE=${params.CONFIG_VALUE}"
                    ]) {
                        sh '''
                            set -eu
                            python3 - <<'PY'
import json
import os

path = os.environ["CONFIG_FILE"]
key = os.environ["CONFIG_KEY"]
raw_value = os.environ["CONFIG_VALUE"]

with open(path, "r", encoding="utf-8") as f:
    data = json.load(f)

try:
    value = json.loads(raw_value)
except json.JSONDecodeError:
    value = raw_value

data[key] = value

with open(path, "w", encoding="utf-8") as f:
    json.dump(data, f, indent=2)
    f.write("\\n")

print(f"Updated {path}: {key} = {value!r}")
PY
                        '''
                    }
                }
            }
        }

        stage('JSON Syntax Validation') {
            steps {
                sh '''
                    set -eu
                    python3 -m json.tool \
                        "environment/${ENVIRONMENT}.json" \
                        > /dev/null
                    python3 -m json.tool \
                        "node/${ENVIRONMENT}.json" \
                        > /dev/null
                    echo "JSON syntax validation passed."
                '''
            }
        }

        stage('Environment / Node Validation') {
            steps {
                script {
                    def validator = params.CONFIG_TYPE == 'environment'
                        ? 'validation/validate_environment.py'
                        : 'validation/validate_node.py'

                    withEnv(["VALIDATOR=${validator}"]) {
                        sh '''
                            set -eu
                            python3 "$VALIDATOR"
                        '''
                    }
                }
            }
        }

        stage('Maven Build') {
            steps {
                sh 'mvn clean test'
            }
        }

        stage('Code Quality') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    withCredentials([
                        string(
                            credentialsId: 'sonarqube-token',
                            variable: 'SONAR_TOKEN'
                        )
                    ]) {
                        sh '''
                            set -eu
                            mvn \
                              org.sonarsource.scanner.maven:sonar-maven-plugin:5.1.0.4751:sonar \
                              -Dsonar.projectKey="$SONAR_PROJECT_KEY" \
                              -Dsonar.token="$SONAR_TOKEN"
                        '''
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    script {
                        def qg = waitForQualityGate()
                        echo "SonarQube Quality Gate: ${qg.status}"

                        if (qg.status != 'OK') {
                            error "Quality Gate failed: ${qg.status}"
                        }
                    }
                }
            }
        }

        stage('Nexus') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus-credentials',
                        usernameVariable: 'NEXUS_USERNAME',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )
                ]) {
                    configFileProvider([
                        configFile(
                            fileId: 'nexus-maven-settings',
                            variable: 'MAVEN_SETTINGS'
                        )
                    ]) {
                        sh '''
                            set -eu
                            mvn \
                              -s "$MAVEN_SETTINGS" \
                              deploy \
                              -DskipTests
                        '''
                    }
                }
            }
        }

        stage('Commit') {
            steps {
                script {
                    def configFile =
                        "${params.CONFIG_TYPE}/${params.ENVIRONMENT}.json"

                    withEnv(["CONFIG_FILE=${configFile}"]) {
                        sh '''
                            set -eu
                            git config user.name "Jenkins"
                            git config user.email "jenkins@localhost"

                            git add "$CONFIG_FILE"

                            if git diff --cached --quiet; then
                                echo "No configuration changes to commit."
                            else
                                git commit -m \
                                  "Update ${ENVIRONMENT} ${CONFIG_TYPE} configuration"
                            fi
                        '''
                    }
                }
            }
        }

        stage('Push feature') {
            steps {
                sshagent(credentials: ['github-ssh']) {
                    sh '''
                        set -eu
                        git push origin HEAD:feature
                    '''
                }
            }
        }

        stage('Create PR') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'github-token',
                        variable: 'GH_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu
                        export GH_TOKEN

                        if gh pr view feature \
                            --repo "$REPO_NAME" >/dev/null 2>&1; then
                            echo "Pull request already exists for feature."
                        else
                            gh pr create \
                                --repo "$REPO_NAME" \
                                --base main \
                                --head feature \
                                --title "Update configuration" \
                                --body "Automated configuration update from Jenkins."
                        fi
                    '''
                }
            }
        }

        stage('PR Validation') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'github-token',
                        variable: 'GH_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu
                        export GH_TOKEN

                        PR_URL=$(gh pr view feature \
                            --repo "$REPO_NAME" \
                            --json url --jq .url)

                        PR_STATE=$(gh pr view "$PR_URL" \
                            --repo "$REPO_NAME" \
                            --json state --jq .state)

                        echo "Pull request: $PR_URL"
                        echo "Pull request state: $PR_STATE"

                        if [ "$PR_STATE" = "MERGED" ]; then
                            echo "PR is already merged."
                        elif [ "$PR_STATE" = "OPEN" ]; then
                            echo "PR is open and ready for auto-merge."
                        else
                            echo "ERROR: PR is closed without merging."
                            exit 1
                        fi
                    '''
                }
            }
        }

        stage('Auto Merge') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'github-token',
                        variable: 'GH_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu
                        export GH_TOKEN

                        PR_STATE=$(gh pr view feature \
                            --repo "$REPO_NAME" \
                            --json state --jq .state)

                        if [ "$PR_STATE" = "MERGED" ]; then
                            echo "PR already merged; nothing to do."
                        elif [ "$PR_STATE" = "OPEN" ]; then
                            gh pr merge feature \
                                --repo "$REPO_NAME" \
                                --merge
                        else
                            echo "ERROR: PR cannot be merged."
                            exit 1
                        fi
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully.'
        }
        failure {
            echo 'Pipeline failed. Review the stage logs.'
        }
        aborted {
            echo 'Pipeline was aborted.'
        }
        always {
            echo "Build result: ${currentBuild.currentResult}"
        }
    }
}
