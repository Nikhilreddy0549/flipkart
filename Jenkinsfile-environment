pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    parameters {
        choice(
            name: 'CONFIG_TYPE',
            choices: ['environment', 'node'],
            description: 'Select the configuration type to update'
        )
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'stage', 'uat', 'prod'],
            description: 'Select the target environment'
        )
        string(
            name: 'CONFIG_KEY',
            defaultValue: 'appName',
            description: 'JSON key to update'
        )
        string(
            name: 'CONFIG_VALUE',
            defaultValue: 'flipkart',
            description: 'New value for the selected JSON key'
        )
    }

    environment {
        GITHUB_REPO = 'Nikhilreddy0549/flipkart'
        GIT_BRANCH = 'feature'
        TARGET_BRANCH = 'main'
        SONAR_PROJECT_KEY = 'flipkart-config-automation'
        NEXUS_URL = 'http://localhost:8082/repository/maven-snapshots/'
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'feature',
                    credentialsId: 'github-ssh',
                    url: 'git@github.com:Nikhilreddy0549/flipkart.git'

                sh '''
                    set -eu
                    git checkout feature
                    git config user.name "Jenkins"
                    git config user.email "jenkins@localhost"
                    echo "Checked out feature branch."
                '''
            }
        }

        stage('Modify Configuration') {
            steps {
                script {
                    env.CONFIG_FILE =
                        "${params.CONFIG_TYPE}/${params.ENVIRONMENT}.json"

                    if (params.CONFIG_TYPE == 'environment') {
                        env.VALIDATOR = 'validation/validate_environment.py'
                    } else {
                        env.VALIDATOR = 'validation/validate_node.py'
                    }
                }

                sh '''
                    set -eu

                    test -f "$CONFIG_FILE" || {
                        echo "Configuration file not found: $CONFIG_FILE"
                        exit 1
                    }

                    python3 - "$CONFIG_FILE" "$CONFIG_KEY" "$CONFIG_VALUE" <<'PY'
import json
import sys

file_path, key, value = sys.argv[1:4]

with open(file_path, "r", encoding="utf-8") as f:
    data = json.load(f)

try:
    parsed_value = json.loads(value)
except json.JSONDecodeError:
    parsed_value = value

data[key] = parsed_value

with open(file_path, "w", encoding="utf-8") as f:
    json.dump(data, f, indent=2)
    f.write("\\n")

print(f"Updated {key} in {file_path}")
PY
                '''
            }
        }

        stage('JSON Syntax Validation') {
            steps {
                sh '''
                    set -eu
                    python3 -m json.tool "$CONFIG_FILE" > /dev/null
                    echo "JSON syntax validation passed."
                '''
            }
        }

        stage('Environment / Node Validation') {
            steps {
                sh '''
                    set -eu
                    python3 "$VALIDATOR" "$CONFIG_FILE" "$ENVIRONMENT"
                    echo "Configuration validation passed."
                '''
            }
        }

        stage('Maven Build and Tests') {
            steps {
                sh '''
                    set -eu
                    mvn clean test
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    withCredentials([
                        string(
                            credentialsId: 'sonarqube-token',
                            variable: 'SONAR_TOKEN'
                        )
                    ]) {
                        sh '''
                            set -eu

                            mvn org.sonarsource.scanner.maven:sonar-maven-plugin:5.1.0.4751:sonar \
                                -Dsonar.projectKey="$SONAR_PROJECT_KEY" \
                                -Dsonar.token="$SONAR_TOKEN"
                        '''
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    script {
                        def qualityGate = waitForQualityGate()

                        echo "SonarQube Quality Gate: ${qualityGate.status}"

                        if (qualityGate.status != 'OK') {
                            error "Quality Gate failed: ${qualityGate.status}"
                        }
                    }
                }
            }
        }

        stage('Deploy to Nexus') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus-credentials',
                        usernameVariable: 'NEXUS_USERNAME',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )
                ]) {
                    configFileProvider([
                        configFile(
                            fileId: 'nexus-maven-settings',
                            variable: 'MAVEN_SETTINGS'
                        )
                    ]) {
                        sh '''
                            set -eu
                            mvn -s "$MAVEN_SETTINGS" deploy -DskipTests
                        '''
                    }
                }
            }
        }

        stage('Commit Changes') {
            steps {
                sh '''
                    set -eu

                    git add "$CONFIG_FILE"

                    if git diff --cached --quiet; then
                        echo "No configuration changes to commit."
                    else
                        git commit -m "Update ${ENVIRONMENT} ${CONFIG_TYPE} configuration"
                    fi
                '''
            }
        }

        stage('Push feature') {
            steps {
                sshagent(credentials: ['github-ssh']) {
                    sh '''
                        set -eu
                        git push origin HEAD:feature
                        echo "Changes pushed to feature."
                    '''
                }
            }
        }

        stage('Create or Find Open PR') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'github-token',
                        variable: 'GH_TOKEN'
                    )
                ]) {
                    script {
                        env.PR_NUMBER = sh(
                            script: '''
                                set -eu
                                export GH_TOKEN

                                gh pr list \
                                    --repo "$GITHUB_REPO" \
                                    --base "$TARGET_BRANCH" \
                                    --head "$GIT_BRANCH" \
                                    --state open \
                                    --json number \
                                    --jq '.[0].number // empty'
                            ''',
                            returnStdout: true
                        ).trim()

                        if (env.PR_NUMBER) {
                            echo "Using existing open PR #${env.PR_NUMBER}"
                        } else {
                            echo "No open PR found. Creating a new PR."

                            env.PR_NUMBER = sh(
                                script: '''
                                    set -eu
                                    export GH_TOKEN

                                    gh pr create \
                                        --repo "$GITHUB_REPO" \
                                        --base "$TARGET_BRANCH" \
                                        --head "$GIT_BRANCH" \
                                        --title "Automated configuration update" \
                                        --body "Configuration changes generated and validated by Jenkins."
                                ''',
                                returnStdout: true
                            ).trim().tokenize('/').last()

                            echo "Created PR #${env.PR_NUMBER}"
                        }

                        env.PR_URL =
                            "https://github.com/${env.GITHUB_REPO}/pull/${env.PR_NUMBER}"

                        echo "Pull request URL: ${env.PR_URL}"
                    }
                }
            }
        }

        stage('PR Validation') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'github-token',
                        variable: 'GH_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu
                        export GH_TOKEN

                        PR_STATE=$(gh pr view "$PR_NUMBER" \
                            --repo "$GITHUB_REPO" \
                            --json state \
                            --jq '.state')

                        echo "Pull request: $PR_URL"
                        echo "Pull request state: $PR_STATE"

                        if [ "$PR_STATE" != "OPEN" ]; then
                            echo "Expected an open PR before merging."
                            exit 1
                        fi
                    '''
                }
            }
        }

        stage('Auto Merge into main') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'github-token',
                        variable: 'GH_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu
                        export GH_TOKEN

                        PR_STATE=$(gh pr view "$PR_NUMBER" \
                            --repo "$GITHUB_REPO" \
                            --json state \
                            --jq '.state')

                        if [ "$PR_STATE" = "MERGED" ]; then
                            echo "PR #$PR_NUMBER is already merged."
                        elif [ "$PR_STATE" = "OPEN" ]; then
                            echo "Merging PR #$PR_NUMBER into main."

                            gh pr merge "$PR_NUMBER" \
                                --repo "$GITHUB_REPO" \
                                --merge

                            echo "Merge command completed."
                        else
                            echo "PR is not open. Current state: $PR_STATE"
                            exit 1
                        fi
                    '''
                }
            }
        }

        stage('Verify main') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'github-token',
                        variable: 'GH_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu
                        export GH_TOKEN

                        gh pr view "$PR_NUMBER" \
                            --repo "$GITHUB_REPO" \
                            --json state,mergedAt,baseRefName \
                            --jq '"State: \\(.state), target: \\(.baseRefName), mergedAt: \\(.mergedAt)"'

                        git fetch origin main
                        echo "Latest main commit:"
                        git log -1 --oneline origin/main
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully.'
            echo 'Configuration was validated, analyzed, deployed, and the PR merge stage completed.'
        }

        failure {
            echo 'Pipeline failed. Check the failed stage in the Jenkins console output.'
        }

        always {
            echo "Build result: ${currentBuild.currentResult}"
        }
    }
}
